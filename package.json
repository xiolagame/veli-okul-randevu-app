{
  "name": "veli-okul-randevu-sistemi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "clean:build": "node scripts/clean-build-artifacts.mjs",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server/server.cjs",
    "build": "npm run clean:build && npm run build:client && npm run build:server && npm run test:release-artifacts",
    "build:android": "node scripts/build-android-client.mjs",
    "build:ios": "node scripts/build-ios-client.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "ios:sync": "node scripts/sanitize-fcm-ios-logs.mjs && npm run build:ios && cap sync ios",
    "android:sync:review": "node scripts/prepare-store-review.mjs android",
    "ios:sync:review": "node scripts/prepare-store-review.mjs ios",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "start": "node dist/server/server.cjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "test:auth": "tsx scripts/test-activation-auth.ts",
    "test:activation": "tsx scripts/test-activation-auth.ts",
    "test:parent-auth": "tsx scripts/test-parent-self-service-auth.ts",
    "test:whatsapp-auth": "tsx scripts/test-whatsapp-auth.ts",
    "test:whatsapp-unified": "tsx scripts/test-unified-whatsapp-login.ts",
    "test:whatsapp-login-ui": "tsx scripts/test-whatsapp-login-ui.ts",
    "test:whatsapp-migrations": "tsx scripts/test-whatsapp-migrations.ts",
    "test:whatsapp-pilot": "tsx scripts/test-whatsapp-pilot.ts",
    "test:identity-auth-attempts": "tsx scripts/test-identity-auth-attempts.ts",
    "test:phone-centric-auth": "tsx scripts/test-identity-auth-attempts.ts",
    "audit:canonical-phones": "tsx scripts/audit-canonical-phone-collisions.ts",
    "test:parent-ux": "tsx scripts/test-parent-ux.ts",
    "test:school-roster-ui": "tsx scripts/test-school-roster-ui.ts",
    "test:first-student": "tsx scripts/test-first-student-empty-school.ts",
    "test:school-admin-provisioning": "tsx scripts/test-school-admin-provisioning.ts",
    "test:school-license": "tsx scripts/test-school-license.ts",
    "test:roster-qr-flow": "tsx scripts/test-roster-qr-availability-security.ts",
    "test:settings-email-reminders": "tsx scripts/test-settings-email-reminders.ts",
    "test:platform-school-deletion": "tsx scripts/test-platform-school-deletion.ts",
    "test:platform-navigation": "tsx scripts/test-platform-admin-navigation.ts",
    "test:platform-requests": "tsx scripts/test-platform-requests.ts",
    "test:support-conversations": "tsx scripts/test-support-conversations.ts",
    "test:platform-unseen": "tsx scripts/test-platform-unseen.ts",
    "test:platform-audit-clear": "tsx scripts/test-platform-audit-clear.ts",
    "test:platform-phone-binding": "tsx scripts/test-platform-phone-binding.ts",
    "test:help-center": "node scripts/test-help-center.mjs",
    "test:release-artifacts": "node scripts/test-release-artifacts.mjs",
    "test:mobile-platform": "tsx scripts/test-mobile-platform-foundation.ts",
    "test:secure-storage": "tsx scripts/test-native-secure-storage.ts",
    "test:android-shell": "tsx scripts/test-android-shell.ts",
    "test:ios-shell": "node scripts/test-ios-shell.ts",
    "test:ios-push": "tsx scripts/test-ios-push.ts",
    "test:push-notifications": "tsx scripts/test-push-notifications.ts",
    "test:account-deletion": "tsx scripts/test-account-deletion.ts",
    "test:auth:production": "tsx scripts/test-production-auth-guards.ts",
    "normalize-person-names": "tsx scripts/normalize-person-names.ts --apply",
    "migrate:supabase": "tsx scripts/migrate-store-to-supabase.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/fcm": "8.2.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@electric-sql/pglite": "^0.5.8",
    "@netlify/aws-lambda-compat": "^2.0.3",
    "@netlify/functions": "^6.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "14.5.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "pg": "^8.23.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.10",
    "serverless-http": "^4.0.0",
    "tailwind-merge": "^3.0.2",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "yaml": "2.9.1"
  }
}
